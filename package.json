{
  "name": "vaultmaster",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:api": "turbo dev --filter=@vaultmaster/api",
    "dev:web": "turbo dev --filter=@vaultmaster/web",
    "db:generate": "turbo db:generate --filter=@vaultmaster/api",
    "db:push": "turbo db:push --filter=@vaultmaster/api",
    "db:migrate": "turbo db:migrate --filter=@vaultmaster/api",
    "db:seed": "turbo db:seed --filter=@vaultmaster/api",
    "test:extension:browser": "node --test apps/extension/tests/browser/*.mjs",
    "test:web:browser": "node --test tests/browser/*.mjs",
    "drill:backup-restore": "bash scripts/backup-restore-drill.sh",
    "test:backup-drill-safety": "node --test scripts/tests/backup-drill-safety.test.mjs",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "test:dependency-audit": "node --test scripts/tests/dependency-audit.test.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "verify:extension": "node scripts/verify-extension.mjs",
    "test:docs": "node --test scripts/tests/extension-docs.test.mjs",
    "drill:observability-rollback": "bash scripts/observability-rollback-drill.sh",
    "test:observability": "node --test scripts/tests/observability.test.mjs",
    "build:extension:firefox": "node apps/extension/scripts/build.mjs apps/extension/dist-firefox firefox",
    "package:extension:firefox": "node scripts/package-extension.mjs test-results/vaultmaster-firefox.zip firefox",
    "test:extension:firefox": "node --test apps/extension/tests/firefox/*.test.mjs",
    "test:firefox:recovery": "bash scripts/firefox-checks.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "esbuild": "0.28.2",
    "turbo": "^2.11.7",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "undici@7": "7.29.1",
      "brace-expansion@1": "1.1.21",
      "@babel/core@7": "7.29.6",
      "browserslist@4": "4.28.7",
      "baseline-browser-mapping@2": "2.11.0",
      "@humanfs/node@0.16": "0.16.8",
      "source-map-js@1": "1.2.2"
    }
  }
}
