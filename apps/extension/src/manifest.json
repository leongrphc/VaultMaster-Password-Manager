{
  "manifest_version": 3,
  "name": "VaultMaster Autofill",
  "version": "1.3.1",
  "minimum_chrome_version": "127",
  "description": "Independent encrypted vault session and secure autofill without an open web tab.",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "idle",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "VaultMaster Autofill",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "form-detector.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "passkey-injected.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "VaultMaster Autofill"
    }
  },
  "key": ""
}
