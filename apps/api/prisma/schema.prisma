generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  masterPasswordHash String
  kdfSalt            String
  kdfIterations      Int          @default(600000)
  wrappedVaultKey    String?
  wrappedVaultKeyIv  String?
  vaultKeyVersion    Int          @default(0)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean      @default(false)
  twoFactorRecoveryCodes Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  vaultItems               VaultItem[]
  folders                  Folder[]
  devices                  Device[]
  auditEvents              AuditEvent[]
  webAuthnCredentials      WebAuthnCredential[]
  ownedSharedVaults        SharedVault[] @relation("SharedVaultOwner")
  sharedVaultMemberships   SharedVaultMember[]
  emergencyAccessGrants    EmergencyAccessGrant[] @relation("EmergencyAccessOwner")
  emergencyAccessContacts  EmergencyAccessGrant[] @relation("EmergencyAccessContact")

  @@map("users")
}

model Folder {
  id        String      @id @default(uuid())
  name      String
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     VaultItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@map("folders")
}

model VaultItem {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  encryptedData String
  iv            String

  favorite      Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  versions      VaultItemVersion[]
  attachments   Attachment[]

  @@index([userId])
  @@index([folderId])
  @@index([userId, deletedAt])
  @@map("vault_items")
}

model VaultItemVersion {
  id            String   @id @default(uuid())
  vaultItemId    String
  vaultItem      VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  encryptedData String
  iv            String
  folderId      String?
  favorite      Boolean
  reason        String
  createdAt     DateTime @default(now())

  @@index([vaultItemId, createdAt])
  @@map("vault_item_versions")
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String
  deviceType   String
  createdAt                DateTime @default(now())
  lastActive               DateTime @default(now())
  refreshTokenHash         String? @unique
  previousRefreshTokenHash String? @unique
  refreshTokenReusedAt     DateTime?
  auditEvents              AuditEvent[]

  @@index([userId])
  @@map("devices")
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  action    String
  status    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deviceId])
  @@map("audit_events")
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   Json?
  name         String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

model Attachment {
  id                String    @id @default(uuid())
  vaultItemId       String
  vaultItem         VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  userId            String
  encryptedMetadata String
  metadataIv        String
  encryptedBlob     String
  blobIv            String
  size              Int
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vaultItemId])
  @@index([userId])
  @@map("attachments")
}

model SharedVault {
  id                String              @id @default(uuid())
  ownerId           String
  owner             User                @relation("SharedVaultOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  encryptedMetadata String
  metadataIv        String
  members           SharedVaultMember[]
  items             SharedVaultItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([ownerId])
  @@map("shared_vaults")
}

model SharedVaultItem {
  id            String      @id @default(uuid())
  sharedVaultId String
  sharedVault   SharedVault @relation(fields: [sharedVaultId], references: [id], onDelete: Cascade)
  createdById   String
  encryptedData String
  iv            String
  favorite      Boolean     @default(false)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([sharedVaultId])
  @@index([sharedVaultId, deletedAt])
  @@map("shared_vault_items")
}

model SharedVaultMember {
  id                    String      @id @default(uuid())
  sharedVaultId         String
  sharedVault           SharedVault @relation(fields: [sharedVaultId], references: [id], onDelete: Cascade)
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                  String
  encryptedVaultKey     String
  encryptedVaultKeyIv   String
  status                String      @default("pending")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([sharedVaultId, userId])
  @@index([userId])
  @@map("shared_vault_members")
}

model EmergencyAccessGrant {
  id                  String    @id @default(uuid())
  ownerId             String
  owner               User      @relation("EmergencyAccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactId           String
  contact             User      @relation("EmergencyAccessContact", fields: [contactId], references: [id], onDelete: Cascade)
  encryptedAccessKey  String
  encryptedAccessIv   String
  waitTimeDays        Int
  status              String    @default("pending")
  requestedAt         DateTime?
  availableAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([ownerId, contactId])
  @@index([contactId])
  @@map("emergency_access_grants")
}
