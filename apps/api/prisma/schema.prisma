generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  masterPasswordHash String
  kdfSalt            String
  kdfIterations      Int          @default(600000)
  wrappedVaultKey    String?
  wrappedVaultKeyIv  String?
  vaultKeyVersion    Int          @default(0)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean      @default(false)
  twoFactorRecoveryCodes Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  reauthentications Reauthentication[]
  securityNotifications SecurityNotification[]
  vaultItems               VaultItem[]
  backupRestores           BackupRestore[]
  backupTransfers          BackupTransfer[]
  folders                  Folder[]
  devices                  Device[]
  auditEvents              AuditEvent[]
  webAuthnCredentials      WebAuthnCredential[]
  ownedSharedVaults        SharedVault[] @relation("SharedVaultOwner")
  sharedVaultMemberships   SharedVaultMember[]
  emergencyAccessGrants    EmergencyAccessGrant[] @relation("EmergencyAccessOwner")
  emergencyAccessContacts  EmergencyAccessGrant[] @relation("EmergencyAccessContact")

  @@map("users")
}

model BackupRestore {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupId  String
  counts    Json
  createdAt DateTime @default(now())

  @@unique([userId, backupId])
  @@map("backup_restores")
}

model Folder {
  id        String      @id @default(uuid())
  name      String
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     VaultItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@map("folders")
}

model VaultItem {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  encryptedData String
  iv            String

  favorite      Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  versions      VaultItemVersion[]
  attachments   Attachment[]

  @@index([userId])
  @@index([folderId])
  @@index([userId, deletedAt])
  @@map("vault_items")
}

model VaultItemVersion {
  id            String   @id @default(uuid())
  vaultItemId    String
  vaultItem      VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  encryptedData String
  iv            String
  folderId      String?
  favorite      Boolean
  reason        String
  createdAt     DateTime @default(now())

  @@index([vaultItemId, createdAt])
  @@map("vault_item_versions")
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String
  deviceType   String
  createdAt                DateTime @default(now())
  lastActive               DateTime @default(now())
  refreshTokenHash         String? @unique
  previousRefreshTokenHash String? @unique
  refreshTokenReusedAt     DateTime?
  exchangeKey ExchangeKey?
  auditEvents              AuditEvent[]
  reauthentications Reauthentication[]

  @@index([userId])
  @@map("devices")
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  action    String
  status    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([deviceId])
  @@map("audit_events")
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   Json?
  name         String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("webauthn_credentials")
}

model Attachment {
  id                String    @id @default(uuid())
  vaultItemId       String
  vaultItem         VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  userId            String
  encryptedMetadata String
  metadataIv        String
  encryptedBlob     String
  blobIv            String
  size              Int
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([vaultItemId])
  @@index([userId])
  @@map("attachments")
}

model SharedVault {
  id                String              @id @default(uuid())
  ownerId           String
  owner             User                @relation("SharedVaultOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  encryptedMetadata String
  metadataIv        String
  members           SharedVaultMember[]
  items             SharedVaultItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([ownerId])
  @@map("shared_vaults")
}

model SharedVaultItem {
  id            String      @id @default(uuid())
  sharedVaultId String
  sharedVault   SharedVault @relation(fields: [sharedVaultId], references: [id], onDelete: Cascade)
  createdById   String
  encryptedData String
  iv            String
  favorite      Boolean     @default(false)
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([sharedVaultId])
  @@index([sharedVaultId, deletedAt])
  @@map("shared_vault_items")
}

model SharedVaultMember {
  id                    String      @id @default(uuid())
  sharedVaultId         String
  sharedVault           SharedVault @relation(fields: [sharedVaultId], references: [id], onDelete: Cascade)
  userId                String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                  String
  encryptedVaultKey     String
  encryptedVaultKeyIv   String
  status                String      @default("pending")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([sharedVaultId, userId])
  @@index([userId])
  @@map("shared_vault_members")
}

model EmergencyAccessGrant {
  id                  String    @id @default(uuid())
  ownerId             String
  owner               User      @relation("EmergencyAccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contactId           String
  contact             User      @relation("EmergencyAccessContact", fields: [contactId], references: [id], onDelete: Cascade)
  encryptedAccessKey  String
  encryptedAccessIv   String
  waitTimeDays        Int
  status              String    @default("pending")
  requestedAt         DateTime?
  availableAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([ownerId, contactId])
  @@index([contactId])
  @@map("emergency_access_grants")
}

model BackupTransfer {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction String
  totalBytes Int
  chunkCount Int
  expiresAt DateTime
  chunks BackupTransferChunk[]
  @@index([userId, expiresAt])
  @@map("backup_transfers")
}
model BackupTransferChunk {
  transferId String
  transfer BackupTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  index Int
  data String
  @@id([transferId, index])
  @@map("backup_transfer_chunks")
}

model AbuseBucket {
  key       String   @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt], map: "abuse_buckets_expiry")
  @@map("abuse_buckets")
}

model Reauthentication {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  target String
  stateHash String
  expiresAt DateTime
  @@index([expiresAt], map: "reauthentications_expiry")
  @@map("reauthentications")
}

model SecurityNotification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  action String
  createdAt DateTime @default(now())
  readAt DateTime?
  @@index([userId, createdAt], map: "security_notifications_user_created")
  @@map("security_notifications")
}

// v1 immutable snapshot exchange. Device deletion cascades keys and grants.
model ExchangeKey {
  id String @id
  deviceId String @unique
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  card Json
  wrapped String
  iv String
  sent ExchangeGrant[] @relation("ExchangeSender")
  received ExchangeGrant[] @relation("ExchangeRecipient")
  @@map("exchange_keys")
}
model ExchangeGrant {
  id String @id
  senderKeyId String
  sender ExchangeKey @relation("ExchangeSender", fields: [senderKeyId], references: [id], onDelete: Cascade)
  recipientKeyId String
  recipient ExchangeKey @relation("ExchangeRecipient", fields: [recipientKeyId], references: [id], onDelete: Cascade)
  kind String
  status String @default("pending")
  revision Int @default(0)
  expiresAt DateTime
  requestedAt DateTime?
  waitHours Int @default(24)
  envelope Json?
  creationHash String
  @@index([recipientKeyId, expiresAt])
  @@map("exchange_grants")
}
