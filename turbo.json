{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "SENTRY_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "DATABASE_DIRECT_URL",
        "VAULTMASTER_TEST_DATABASE_URL",
        "VAULTMASTER_TEST_DATABASE_DIRECT_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_EXPIRES_IN",
        "JWT_REFRESH_EXPIRES_IN",
        "APP_ENCRYPTION_KEY",
        "API_PORT",
        "PORT",
        "CORS_ORIGIN"
      ],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "DATABASE_DIRECT_URL",
        "VAULTMASTER_TEST_DATABASE_URL",
        "VAULTMASTER_TEST_DATABASE_DIRECT_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_EXPIRES_IN",
        "JWT_REFRESH_EXPIRES_IN",
        "APP_ENCRYPTION_KEY",
        "API_PORT",
        "PORT",
        "CORS_ORIGIN"
      ],
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "VAULTMASTER_STATIC_EXPORT",
    "VAULTMASTER_APP_URL"
  ]
}
